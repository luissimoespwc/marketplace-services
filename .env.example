# Marketplace services local configuration.
# Copy this file to .env. Do not put real secrets here or in .env committed copies.

NODE_ENV=development
PORT=3000

# Only "stub" is implemented. Startup fails for any other value.
DATAHUB_ADAPTER=stub

# Reserved for a future DataHub adapter. Unused while DATAHUB_ADAPTER=stub.
# Leave the token blank. Never commit a real token.
DATAHUB_GMS_URL=
DATAHUB_TIMEOUT_MS=5000
DATAHUB_TOKEN=

# disabled: every /api route returns 401.
# dev-stub: a fixed local principal. Rejected when NODE_ENV=production.
AUTH_MODE=disabled
